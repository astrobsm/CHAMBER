# Production - use relative path so API calls go to same domain
VITE_API_URL=/api
VITE_WS_URL=

# App Configuration
VITE_APP_NAME=Clinical Rotation Platform
VITE_APP_SHORT_NAME=UNTH Rotations

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Production mode
VITE_DEV_MODE=false
